# install.sh sets NODE_ENV=production and starts PM2. Use NODE_ENV=development only for pnpm dev.
NODE_ENV=development

DATABASE_URL=postgresql://arciin:arciin@localhost:5432/arciin
# PostgreSQL port (install.sh picks 5432, then 5433, 5434, … if 5432 is busy)
ARCIIN_PG_PORT=5432
REDIS_URL=redis://localhost:6379

# Persistent files live OUTSIDE the git clone (recommended for production).
ARCIIN_DATA_DIR=/srv/arciin-storage/arciin
# Docker: host folder bind-mounted to /data/arciin in api/worker (see docs/DOCKER.md)
# ARCIIN_HOST_DATA_DIR=/srv/arciin-storage/arciin
# Dev-only (inside repo — not recommended; removed when you delete the clone):
# ARCIIN_DATA_DIR=./data/arciin
# install.sh auto-generates a random token. For Docker: set this to $(openssl rand -hex 24)
ARCIIN_SETUP_TOKEN=dev-token
# LAN URL for browsers (install.sh sets your machine IP). API rewrites use ARCIIN_API_URL on loopback.
# For iPad/LAN dev on :3002 use your LAN IP here, e.g. http://192.168.4.22:3002
ARCIIN_PUBLIC_URL=http://localhost:3000
# Web UI port (Next.js). Cloudflare tunnel forwards here — not the API port.
ARCIIN_WEB_PORT=3000
# Optional override for cloudflared --url (default http://127.0.0.1:ARCIIN_WEB_PORT)
# ARCIIN_TUNNEL_TARGET=http://127.0.0.1:3000
ARCIIN_API_URL=http://127.0.0.1:4000
PORT=3000
ARCIIN_BIND_HOST=0.0.0.0

NEXT_PUBLIC_API_BASE_URL=/api
# Leave empty for LAN/dev — uploads and chat use the same origin as the page (session cookies).
# Only set when the API is on the SAME host as the web app, e.g. http://192.168.4.22:4001
NEXT_PUBLIC_ARCIIN_API_ORIGIN=
NEXT_PUBLIC_ARCIIN_PUBLIC_URL=
NEXT_PUBLIC_SOCKET_URL=

SESSION_COOKIE_NAME=arciin_session
SESSION_SECRET=change-this-in-production
# Encrypts the credential vault / webhook / integration secrets at rest,
# independently of SESSION_SECRET. install.sh generates this on a fresh install.
# Leave blank on an existing install — the code falls back to SESSION_SECRET so
# already-encrypted data keeps decrypting. 64 hex chars: openssl rand -hex 32
ARCIIN_ENCRYPTION_KEY=

MAX_UPLOAD_SIZE_MB=20480
UPLOAD_RATE_LIMIT_PER_MINUTE=500
LOG_MAX_FILE_BYTES=1800000
API_PORT=4000

# Hosted license server (license.arciin.com) — no Stripe yet
# Start with: pnpm license-server
# Entitlement tokens are verified with the vendor public key shipped in
# packages/config/src/license-signing.ts — nothing to configure. Set this only
# to trust an additional/self-run licensing authority (kid:publicKey,kid:key).
# ARCIIN_LICENSE_PUBLIC_KEYS=
ARCIIN_LICENSE_SERVER_URL=http://127.0.0.1:4100
# Allow ARCIIN-DEV-* mock keys when true (default true in development)
# ARCIIN_LICENSE_DEV_FALLBACK=true

# Public marketing / pricing site (Arciin_web) — in-app "view plans" links
NEXT_PUBLIC_ARCIIN_WEBSITE_URL=https://arciin.com
# Optional customer account portal (already purchased licenses)
# NEXT_PUBLIC_ARCIIN_ACCOUNT_URL=https://arciin.com/account

