# install.sh sets NODE_ENV=production and starts PM2. Use NODE_ENV=development only for pnpm dev.
NODE_ENV=development

DATABASE_URL=postgresql://arciin:arciin@localhost:5432/arciin
# PostgreSQL port (install.sh picks 5432, then 5433, 5434, … if 5432 is busy)
ARCIIN_PG_PORT=5432
REDIS_URL=redis://localhost:6379

ARCIIN_DATA_DIR=./data/arciin
# install.sh auto-generates a random token. For Docker: set this to $(openssl rand -hex 24)
ARCIIN_SETUP_TOKEN=dev-token
# LAN URL for browsers (install.sh sets your machine IP). API rewrites use ARCIIN_API_URL on loopback.
# For iPad/LAN dev on :3002 use your LAN IP here, e.g. http://192.168.4.22:3002
ARCIIN_PUBLIC_URL=http://localhost:3000
ARCIIN_API_URL=http://127.0.0.1:4000
PORT=3000
ARCIIN_BIND_HOST=0.0.0.0

NEXT_PUBLIC_API_BASE_URL=/api
# Leave empty for LAN/dev — uploads and chat use the same origin as the page (session cookies).
# Only set when the API is on the SAME host as the web app, e.g. http://192.168.4.22:4001
NEXT_PUBLIC_ARCIIN_API_ORIGIN=
NEXT_PUBLIC_ARCIIN_PUBLIC_URL=
NEXT_PUBLIC_SOCKET_URL=

SESSION_COOKIE_NAME=arciin_session
SESSION_SECRET=change-this-in-production

MAX_UPLOAD_SIZE_MB=10240
UPLOAD_RATE_LIMIT_PER_MINUTE=500
API_PORT=4000
