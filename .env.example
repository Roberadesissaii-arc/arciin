NODE_ENV=development

DATABASE_URL=postgresql://arciin:arciin@localhost:5432/arciin
# PostgreSQL port (install.sh picks 5432, then 5433, 5434, … if 5432 is busy)
ARCIIN_PG_PORT=5432
REDIS_URL=redis://localhost:6379

ARCIIN_DATA_DIR=./data/arciin
# install.sh auto-generates a random token. For Docker: set this to $(openssl rand -hex 24)
ARCIIN_SETUP_TOKEN=dev-token
ARCIIN_PUBLIC_URL=http://localhost:3000
ARCIIN_API_URL=http://localhost:4000

NEXT_PUBLIC_API_BASE_URL=/api
# Dev: point uploads at Fastify :4000 (skips Next body limits). Docker/Caddy: leave empty — uses /api on the public URL.
NEXT_PUBLIC_ARCIIN_API_ORIGIN=http://localhost:4000
# Dev: leave empty so the browser uses http://localhost:3000 (session cookies + Next /socket.io proxy).
# Do not set to :4000 for local UI — cookies are not sent across ports. Python/scripts use :4000 directly.
# Docker/production behind one public host: leave empty or set your HTTPS origin.
NEXT_PUBLIC_SOCKET_URL=

SESSION_COOKIE_NAME=arciin_session
SESSION_SECRET=change-this-in-production

MAX_UPLOAD_SIZE_MB=10240
API_PORT=4000
