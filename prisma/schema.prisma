generator client {
  provider     = "prisma-client-js"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StorageType {
  LOCAL
}

enum LibraryKind {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  INBOX
  CUSTOM
}

enum MediaType {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum UploadStatus {
  QUEUED
  UPLOADING
  UPLOADED
  ANALYZING
  CLASSIFIED
  PROCESSING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum IntegrationType {
  PLEX
  S3
  WEBHOOK
  CUSTOM
}

model InstanceConfig {
  id                 String   @id @default(cuid())
  instanceName       String
  storageRoot        String
  publicUrl          String?
  remoteAccessMode   String?  @default("local")
  remoteAccessConfig Json?
  initializedAt      DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           UserRole
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  apiKeys        ApiKey[]
  uploads        UploadSession[]
  assets         Asset[]
  activityEvents ActivityEvent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

model StorageLocation {
  id         String          @id @default(cuid())
  name       String
  type       StorageType
  rootPath   String
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  libraries  Library[]
  objects    StorageObject[]
}

model Library {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String?
  kind              LibraryKind
  icon              String?
  color             String?
  storageLocationId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  folders           Folder[]
  assets            Asset[]
  uploadSessions    UploadSession[]
}

model Folder {
  id             String    @id @default(cuid())
  libraryId      String
  parentFolderId String?
  name           String
  slug           String
  pathCache      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  library        Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  parentFolder   Folder?   @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: SetNull)
  childFolders   Folder[]  @relation("FolderTree")
  assets         Asset[]
  uploadSessions UploadSession[]

  @@unique([libraryId, pathCache])
  @@index([libraryId])
  @@index([parentFolderId])
  @@index([deletedAt])
}

model StorageObject {
  id                String          @id @default(cuid())
  storageLocationId String
  objectKey         String          @unique
  physicalPath      String
  sizeBytes         BigInt
  checksumSha256    String
  mimeType          String
  createdAt         DateTime        @default(now())
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  assets            Asset[]

  @@index([storageLocationId])
  @@index([checksumSha256])
}

model Asset {
  id              String       @id @default(cuid())
  libraryId       String
  folderId        String?
  storageObjectId String
  ownerId         String
  filename        String
  originalFilename String
  title           String?
  description     String?
  mimeType        String
  mediaType       MediaType
  extension       String
  sizeBytes       BigInt
  checksumSha256  String
  durationSeconds Float?
  width           Int?
  height          Int?
  codec           String?
  status          AssetStatus
  processingError String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  library         Library      @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  folder          Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  storageObject   StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  uploadSessions  UploadSession[]
  tags            AssetTag[]

  @@index([libraryId])
  @@index([folderId])
  @@index([mediaType])
  @@index([createdAt])
  @@index([deletedAt])
}

model UploadSession {
  id               String       @id @default(cuid())
  userId           String
  originalFilename String
  mimeType         String?
  sizeBytes        BigInt
  status           UploadStatus
  progress         Int          @default(0)
  targetLibraryId  String?
  targetFolderId   String?
  detectedMediaType MediaType?
  assetId          String?
  error            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  completedAt      DateTime?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLibrary    Library?     @relation(fields: [targetLibraryId], references: [id], onDelete: SetNull)
  targetFolder     Folder?      @relation(fields: [targetFolderId], references: [id], onDelete: SetNull)
  asset            Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus
  progress    Int       @default(0)
  payload     Json
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String?
  type       String
  title      String
  message    String?
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
}

model Integration {
  id        String          @id @default(cuid())
  type      IntegrationType
  name      String
  enabled   Boolean         @default(false)
  config    Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([type])
}

model Tag {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  color     String?
  createdAt DateTime   @default(now())
  assets    AssetTag[]
}

model AssetTag {
  assetId String
  tagId   String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
}
