generator client {
  provider     = "prisma-client-js"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StorageType {
  LOCAL
}

enum LibraryKind {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  INBOX
  CUSTOM
}

enum MediaType {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  ARCHIVE
  APPLICATION
  CODE
  OTHER
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum UploadStatus {
  QUEUED
  UPLOADING
  UPLOADED
  ANALYZING
  CLASSIFIED
  PROCESSING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum IntegrationType {
  PLEX
  S3
  WEBHOOK
  CUSTOM
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ShareResourceType {
  ASSET
  ASSETS
  FOLDER
}

enum ShareFeedbackSentiment {
  LIKE
  DISLIKE
}

/// Opaque public link to a single asset or folder (token hash at rest).
model ShareLink {
  id            String             @id @default(cuid())
  createdById   String
  resourceType  ShareResourceType
  assetId       String?
  folderId      String?
  tokenHash     String             @unique
  tokenPrefix   String
  label         String?
  expiresAt     DateTime?
  maxViews      Int?
  viewCount     Int                @default(0)
  allowDownload Boolean            @default(true)
  revokedAt     DateTime?
  lastViewedAt  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  asset         Asset?             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  folder        Folder?            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  shareAssets   ShareLinkAsset[]
  feedback      ShareFeedback[]

  @@index([createdById])
  @@index([assetId])
  @@index([folderId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model ShareLinkAsset {
  id          String    @id @default(cuid())
  shareLinkId String
  assetId     String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([shareLinkId, assetId])
  @@index([shareLinkId])
  @@index([assetId])
}

model ShareFeedback {
  id          String                 @id @default(cuid())
  shareLinkId String
  assetId     String?
  sentiment   ShareFeedbackSentiment
  createdAt   DateTime               @default(now())
  shareLink   ShareLink              @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  asset       Asset?                 @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([shareLinkId])
  @@index([assetId])
  @@index([createdAt])
}

model InstanceConfig {
  id                 String   @id @default(cuid())
  instanceName       String
  storageRoot        String
  publicUrl          String?
  remoteAccessMode   String?  @default("local")
  remoteAccessConfig Json?
  aiConfig           Json?
  /// free | pro | team | business — effective plan may be free after expiry.
  licensePlan        String   @default("free")
  /// none | active | grace | expired
  licenseStatus      String   @default("none")
  licenseKeyPrefix   String?
  licenseActivatedAt DateTime?
  licenseExpiresAt   DateTime?
  /// Premium features stay on until this time after licenseExpiresAt.
  licenseGraceUntil  DateTime?
  /// Locally signed license token (cloud verification later).
  licenseSignedToken String?  @db.Text
  /// mock_dev | token | default
  licenseSource      String?
  initializedAt      DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Encrypted credential rows (AES-256-GCM). Plaintext never sent to AI providers.
model PasswordVaultEntry {
  id         String   @id @default(cuid())
  ciphertext String   @db.Text
  iv         String
  authTag    String
  importSource String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash        String
  recoveryQuestion    String?
  recoveryAnswerHash  String?
  role                UserRole
  status         UserStatus      @default(ACTIVE)
  avatarPath     String?
  preferences    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions            Session[]
  mobilePairingCodes  MobilePairingCode[]
  apiKeys             ApiKey[]
  uploads           UploadSession[]
  assets            Asset[]
  activityEvents    ActivityEvent[]
  appDatabases      AppDatabase[]
  chatConversations ChatConversation[]
  shareLinks        ShareLink[]
}

/// Logical app database for API/automation: metadata + JSON in PostgreSQL (not library file storage).
model AppDatabase {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  folders     AppDatabaseFolder[]

  @@index([createdById])
}

model AppDatabaseFolder {
  id             String               @id @default(cuid())
  databaseId     String
  parentFolderId String?
  name           String
  slug           String
  pathCache      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  database       AppDatabase          @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  parentFolder   AppDatabaseFolder?   @relation("AppDbFolderTree", fields: [parentFolderId], references: [id], onDelete: SetNull)
  childFolders   AppDatabaseFolder[]  @relation("AppDbFolderTree")
  records        AppDatabaseRecord[]

  @@unique([databaseId, pathCache])
  @@index([databaseId])
  @@index([parentFolderId])
  @@index([deletedAt])
}

model AppDatabaseRecord {
  id        String            @id @default(cuid())
  folderId  String
  name      String
  payload   Json
  mimeType  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  folder    AppDatabaseFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, name])
  @@index([folderId])
}

model Session {
  id                 String    @id @default(cuid())
  userId             String
  tokenHash          String    @unique
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  /// Mobile Bearer sessions: vault unlock without relying on cross-origin cookies.
  vaultUnlockedUntil DateTime?
  /// Map of folderId → ISO expiry for temporary folder access while folder stays locked.
  folderUnlocks      Json?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Short-lived codes for pairing the mobile PWA to this instance (hashed at rest).
model MobilePairingCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

model StorageLocation {
  id        String          @id @default(cuid())
  name      String
  type      StorageType
  rootPath  String
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  libraries Library[]
  objects   StorageObject[]
}

model Library {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String?
  kind              LibraryKind
  icon              String?
  color             String?
  storageLocationId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  folders           Folder[]
  assets            Asset[]
  uploadSessions    UploadSession[]
}

model Folder {
  id             String          @id @default(cuid())
  libraryId      String
  parentFolderId String?
  name           String
  slug           String
  pathCache      String
  lockedAt       DateTime?
  lockedByUserId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  library        Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  parentFolder   Folder?         @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: SetNull)
  childFolders   Folder[]        @relation("FolderTree")
  assets         Asset[]
  uploadSessions UploadSession[]
  shareLinks     ShareLink[]

  @@unique([libraryId, pathCache])
  @@index([libraryId])
  @@index([parentFolderId])
  @@index([deletedAt])
}

model StorageObject {
  id                String          @id @default(cuid())
  storageLocationId String
  objectKey         String          @unique
  physicalPath      String
  sizeBytes         BigInt
  checksumSha256    String
  mimeType          String
  createdAt         DateTime        @default(now())
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  assets            Asset[]

  @@index([storageLocationId])
  @@index([checksumSha256])
}

model Asset {
  id               String          @id @default(cuid())
  libraryId        String
  folderId         String?
  storageObjectId  String
  ownerId          String
  filename         String
  originalFilename String
  title            String?
  description      String?
  mimeType         String
  mediaType        MediaType
  extension        String
  sizeBytes        BigInt
  checksumSha256   String
  durationSeconds  Float?
  width            Int?
  height           Int?
  codec            String?
  status           AssetStatus
  processingError  String?
  /// Original public link this asset was imported from (used to show a source badge).
  importSourceUrl  String?
  /// Device channel the upload request came from ("web" | "mobile") — fallback badge when there's no import source.
  uploadClient     String?
  /// Custom badge label override (null = auto-detect from importSourceUrl).
  badgeLabel       String?
  /// Custom badge color override as hex (null = auto-detect or default).
  badgeColor       String?
  /// When false, the source badge is hidden on cards and lists.
  showBadge        Boolean         @default(true)
  /// Relative path under storage root for Plex-visible library mirror (e.g. libraries/videos/plex/file.mp4).
  libraryMirrorPath String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  library          Library         @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  folder           Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  storageObject    StorageObject   @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  owner            User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  uploadSessions   UploadSession[]
  tags             AssetTag[]
  shareLinks       ShareLink[]
  shareLinkAssets  ShareLinkAsset[]
  shareFeedback    ShareFeedback[]

  @@index([libraryId])
  @@index([folderId])
  @@index([ownerId])
  @@index([storageObjectId])
  @@index([status])
  @@index([mediaType])
  @@index([createdAt])
  @@index([deletedAt])
  // Composite indexes matching the hot list queries (library/folder browse,
  // newest-first, excluding soft-deleted) so large libraries don't degrade to
  // index-scan-plus-sort under concurrent load.
  @@index([libraryId, deletedAt, createdAt(sort: Desc)])
  @@index([folderId, deletedAt, createdAt(sort: Desc)])
}

model UploadSession {
  id                String       @id @default(cuid())
  userId            String
  originalFilename  String
  mimeType          String?
  sizeBytes         BigInt
  status            UploadStatus
  progress          Int          @default(0)
  targetLibraryId   String?
  targetFolderId    String?
  detectedMediaType MediaType?
  assetId           String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  completedAt       DateTime?
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLibrary     Library?     @relation(fields: [targetLibraryId], references: [id], onDelete: SetNull)
  targetFolder      Folder?      @relation(fields: [targetFolderId], references: [id], onDelete: SetNull)
  asset             Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([assetId])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus
  progress    Int       @default(0)
  payload     Json
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String?
  type       String
  title      String
  message    String?
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

model Integration {
  id        String          @id @default(cuid())
  type      IntegrationType
  name      String
  enabled   Boolean         @default(false)
  config    Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([type])
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  name         String
  url          String
  enabled      Boolean  @default(true)
  eventTypes   String[]
  secretPrefix String
  secretEnc    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([enabled])
  @@index([createdAt])
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  endpointId   String
  eventType    String
  status       WebhookDeliveryStatus
  requestBody  Json
  responseCode Int?
  responseBody String?
  durationMs   Int?
  error        String?
  createdAt    DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status])
}

model Tag {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  color     String?
  createdAt DateTime   @default(now())
  assets    AssetTag[]
}

model AssetTag {
  assetId String
  tagId   String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
}

model ModelProfile {
  id           String   @id @default(cuid())
  provider     String   // "openai" | "anthropic" | "ollama" | "gemini" | "deepseek" | "grok" | "meta" | "qwen" | "elevenlabs" | "custom"
  displayName  String
  apiKey       String?
  baseUrl      String?
  defaultModel String?
  ttsModel     String?
  isDefault    Boolean  @default(false)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations ChatConversation[]

  @@index([provider])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  profileId String?
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile  ModelProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, createdAt])
  @@index([profileId])
}

enum ChatMessageFeedbackRating {
  LIKE
  DISLIKE
}

model ChatMessage {
  id             String                     @id @default(cuid())
  conversationId String
  role           String
  content        String
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  feedbackRating ChatMessageFeedbackRating?
  feedbackAt     DateTime?
  createdAt      DateTime                   @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
