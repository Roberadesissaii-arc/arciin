# Arciin web image.
#
# Multi-stage: the Next build needs tailwind, typescript and the type packages;
# `next start` needs none of them. The previous single-stage image shipped the
# whole toolchain plus the test and docs tree.
#
# The pdfjs WASM copy is explicit rather than left to `postinstall`, because the
# install runs with --ignore-scripts (scripts/ is not in that layer yet). Without
# it PDF preview renders a grey placeholder, so it is not optional.

# ---------- builder ----------
# Node 24, matching the runtime this release was certified on.
#
# The images pinned node:20-alpine while every other gate ran on Node 24, and
# the dependency tree had moved past it: undici 8 calls
# webidl.util.markAsUncloneable, which does not exist before Node 22, so the
# API container built cleanly, applied its migrations, and then died on its
# first import. package.json now declares engines.node >= 22 so the two cannot
# drift apart again.
# Debian slim, not Alpine.
#
# pdfjs-dist pulls @napi-rs/canvas, and its musl build dies with SIGILL —
# "Illegal instruction (core dumped)" — the moment pdfjs is imported. That is a
# native crash no try/catch can see, so it took the worker process down with it:
# a PDF upload left its metadata job stalled, the asset stuck on PROCESSING, and
# the container restarting. The glibc build is what the host this release was
# verified on actually runs, so the image now matches it.
FROM node:24-slim AS builder
WORKDIR /app
# Bake the pinned pnpm into the image.
#
# `corepack enable` alone only installs the shim: the first pnpm invocation
# downloads the version pinned in package.json. That turned every container
# start into a call to the npm registry, which a production host is entitled to
# block — and on this one it printed "Corepack is about to download pnpm" and
# the worker restarted twice, abandoning a job mid-flight. Preparing it at build
# time means the running container never reaches for the network to start.
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/media-ai/package.json packages/media-ai/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

ARG NEXT_PUBLIC_API_BASE_URL=/api
ARG NEXT_PUBLIC_SOCKET_URL=
ARG NEXT_PUBLIC_ARCIIN_API_ORIGIN=
ARG ARCIIN_PUBLIC_URL=http://localhost

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}
ENV NEXT_PUBLIC_ARCIIN_API_ORIGIN=${NEXT_PUBLIC_ARCIIN_API_ORIGIN}
ENV ARCIIN_PUBLIC_URL=${ARCIIN_PUBLIC_URL}

RUN pnpm pdfjs:copy-wasm && pnpm db:generate && pnpm build:web

# ---------- runtime ----------
FROM node:24-slim AS runtime
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/media-ai/package.json packages/media-ai/package.json

RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# Workspace packages are transpiled by Next at build time, but next.config.ts
# and the proxy still resolve them at boot.
COPY packages ./packages
COPY apps/web/next.config.ts apps/web/proxy.ts apps/web/next-env.d.ts ./apps/web/
COPY tsconfig.base.json tsconfig.json ./

# Build output and static assets (public/ carries the copied pdfjs wasm).
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY prisma ./prisma

# Generate the Prisma client here rather than copying it from the builder.
# pnpm keeps the generated client inside its virtual store
# (node_modules/.pnpm/@prisma+client@…/node_modules/.prisma), so there is no
# node_modules/.prisma to copy — the COPY that tried failed the build outright.
# The CLI and the schema are both present in this stage, so generating is both
# simpler and correct wherever pnpm decides to put it.
RUN pnpm db:generate

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Run as a non-root user (uid/gid 1000 by default). Pin a matching host uid via
# `user:` in compose so the bind-mounted data dir stays writable.
# node:*-slim already ships a "node" user at uid 1000 — reuse it rather than
# failing on a duplicate id.
RUN set -eu; \
    getent group 1000 >/dev/null 2>&1 || groupadd -g 1000 arciin; \
    getent passwd 1000 >/dev/null 2>&1 || useradd -u 1000 -g 1000 -M -s /usr/sbin/nologin arciin; \
    chown -R 1000:1000 /app
USER 1000:1000

CMD ["pnpm", "start:web"]
