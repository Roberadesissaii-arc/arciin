# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# pm2 / install logs
/logs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example
!.env.production.example

# private distribution packaging output
/dist/

# hosted license server SQLite (prototype)
/apps/license-server/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference project (local only)
/Arceclaw

# Local media (use /srv/arciin-storage/arciin in production — see docs/DOCKER.md)
/data/

# IDE / local tool configs
/.claude/
/.cursor/
.mcp.json
data/
__pycache__/
*.pyc
.env.docker.test
docker-compose.smoke.yml
