# Arciin — Docker Compose environment
# Copy: cp .env.docker.example .env
# Or run: ./scripts/docker-setup.sh

NODE_ENV=production

# ── Host storage (bind mount) ───────────────────────────────────────────────
# Path on YOUR machine (SSD/HDD/NAS). Files are written here, not inside the container.
# Default keeps data outside the git clone so app updates do not touch your media.
# Examples:
#   /srv/arciin-storage/arciin       (recommended default)
#   /mnt/nvme/arciin-data            (dedicated NVMe mount)
#   /media/nas/MyDrive/arciin-data   (USB or network mount)
#   ./data/arciin                    (dev-only — inside the repo)
ARCIIN_HOST_DATA_DIR=/srv/arciin-storage/arciin

# Inside api/worker containers (do not change unless you change compose mounts)
ARCIIN_DATA_DIR=/data/arciin

# ── Secrets (required) ──────────────────────────────────────────────────────
# scripts/docker-setup.sh generates these if missing
ARCIIN_SETUP_TOKEN=change-me
SESSION_SECRET=change-me

# ── URLs ────────────────────────────────────────────────────────────────────
# Browser URL. Docker+Caddy serves on port 80:
#   http://localhost          — this machine
#   http://192.168.x.x        — LAN (set to your Pi/server IP)
ARCIIN_PUBLIC_URL=http://localhost
ARCIIN_API_URL=http://api:4000

# Leave empty so the browser uses the same origin (recommended behind Caddy)
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_ARCIIN_API_ORIGIN=
NEXT_PUBLIC_ARCIIN_PUBLIC_URL=

SESSION_COOKIE_NAME=arciin_session

MAX_UPLOAD_SIZE_MB=10240
UPLOAD_RATE_LIMIT_PER_MINUTE=500
LOG_MAX_FILE_BYTES=1800000

# ── Database / Redis (set by docker-compose.yml — do not point at localhost) ─
# DATABASE_URL=postgresql://arciin:arciin@postgres:5432/arciin
# REDIS_URL=redis://redis:6379

# Same features as native install: migrations run via scripts/arciin-init.sh in the API
# container; storage uses ARCIIN_HOST_DATA_DIR on the host; web + api + worker + Caddy.
