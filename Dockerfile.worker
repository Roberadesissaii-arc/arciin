# Arciin worker image.
#
# Same shape as Dockerfile.api and for the same reason: the previous single
# stage shipped the full dev toolchain and the whole repo. The worker also runs
# from TypeScript source via tsx, so apps/worker/src and tsx are runtime, not
# build input.

# ---------- deps ----------
FROM node:20-alpine AS deps
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/media-ai/package.json packages/media-ai/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts

# ---------- builder: Prisma client ----------
FROM deps AS builder
WORKDIR /app
COPY . .
RUN pnpm db:generate

# ---------- runtime ----------
FROM node:20-alpine AS runtime
WORKDIR /app

# Media pipeline tools: ffmpeg (video/audio probe + transcode), poppler-utils
# (pdftoppm for document thumbnails), yt-dlp + gallery-dl (URL imports).
RUN apk add --no-cache ffmpeg poppler-utils yt-dlp gallery-dl

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/media-ai/package.json packages/media-ai/package.json

RUN pnpm install --frozen-lockfile --prod --ignore-scripts

COPY apps/worker ./apps/worker
COPY apps/api ./apps/api
COPY packages ./packages
COPY prisma ./prisma
COPY scripts ./scripts
COPY tsconfig.base.json tsconfig.json ./

COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client

ENV NODE_ENV=production

# The worker shells out to media tools (ffmpeg/yt-dlp) on remote input — never
# as root. Pin a matching host uid via `user:` in compose for bind-mount writes.
# Base images sometimes already ship a uid/gid 1000 user (e.g. node:alpine's
# built-in "node") — reuse it instead of failing on a duplicate id.
RUN set -eu; \
    getent group 1000 >/dev/null 2>&1 || addgroup -S -g 1000 arciin; \
    getent passwd 1000 >/dev/null 2>&1 || adduser -S -u 1000 -G "$(getent group 1000 | cut -d: -f1)" arciin; \
    chown -R 1000:1000 /app
USER 1000:1000

CMD ["pnpm", "tsx", "--tsconfig", "apps/worker/tsconfig.json", "apps/worker/src/index.ts"]
