FROM node:20-alpine

WORKDIR /app

# Media pipeline tools: ffmpeg (video/audio probe + transcode), poppler-utils
# (pdftoppm for document thumbnails), yt-dlp + gallery-dl (URL imports).
RUN apk add --no-cache ffmpeg poppler-utils yt-dlp gallery-dl

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json

# postinstall needs scripts/ on disk — not available until full COPY.
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

RUN pnpm db:generate

ENV NODE_ENV=production

# The worker shells out to media tools (ffmpeg/yt-dlp) on remote input — never
# as root. Pin a matching host uid via `user:` in compose for bind-mount writes.
# Base images sometimes already ship a uid/gid 1000 user (e.g. node:alpine's
# built-in "node") — reuse it instead of failing on a duplicate id.
RUN set -eu; \
    getent group 1000 >/dev/null 2>&1 || addgroup -S -g 1000 arciin; \
    getent passwd 1000 >/dev/null 2>&1 || adduser -S -u 1000 -G "$(getent group 1000 | cut -d: -f1)" arciin; \
    chown -R 1000:1000 /app
USER 1000:1000

CMD ["pnpm", "tsx", "--tsconfig", "apps/worker/tsconfig.json", "apps/worker/src/index.ts"]
