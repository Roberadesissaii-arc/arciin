# Dependencies & build output
node_modules
.next
dist
.turbo
coverage

# Git & editor
.git
.cursor
.vscode

# Secrets (never bake into images)
.env
.env.*
!.env.example
!.env.docker.example

# Logs (root only — do not use bare `logs`; it is too broad)
*.log
/logs
/logs/**

# ── Arciin runtime storage on disk (repo ROOT only) ───────────────────────────
# Leading `/` is required. Without it, `libraries` would also exclude
# `components/libraries/` (React UI) and break `next build` in Docker CI.
/objects
/objects/**
/libraries
/libraries/**
/thumbnails
/thumbnails/**
/temp
/temp/**
/avatars
/avatars/**

# Dev-only in-repo storage
/data
/data/**

# Local PM2 / runtime
.pm2
