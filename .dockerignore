# ── Arciin runtime storage (NEVER copy into Docker build context) ─────────────
# If ARCIIN_HOST_DATA_DIR points inside this repo, these folders can be gigabytes
# of media and will cause "no space left on device" during `docker compose build`.
objects
libraries
thumbnails
temp
avatars
**/objects/**
