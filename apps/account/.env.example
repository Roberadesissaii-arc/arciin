# Local prototype portal for the licensing authority.
# Superseded by the customer account area on arciin-web — kept for local use.
PORT=3010

LICENSE_SERVER_URL=http://127.0.0.1:4100

# Service credential — must be one of LICENSE_SERVICE_TOKENS on the license
# server. Server-only; never expose as NEXT_PUBLIC_.
# LICENSE_SERVICE_TOKEN=

# Admin credential for the local key generator and hard delete — must be one of
# LICENSE_ADMIN_TOKENS on the license server.
# LICENSE_ADMIN_TOKEN=

# Demo customer identity (no real auth in this prototype)
ACCOUNT_DEMO_EMAIL=you@yourserver.com
ACCOUNT_DEMO_NAME=Demo Customer
