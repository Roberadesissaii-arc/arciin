      "source": "/applications",
      "destination": "/inbox",
      "statusCode": 308,
      "regex": "^(?!/_next)/applications(?:/)?$"
    },
    {
      "source": "/applications/:path*",
      "destination": "/inbox",
      "statusCode": 308,
      "regex": "^(?!/_next)/applications(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
