// Hosted license server (future license.arciin.com) — prototype schema.
// Separate database from the self-hosted Arciin instance.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/license-client"
}

datasource db {
  provider = "sqlite"
  url      = env("LICENSE_DATABASE_URL")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  licenses  License[]
}

model License {
  id          String       @id @default(cuid())
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Display prefix only (never the full key).
  keyPrefix   String
  /// SHA-256 hex of normalized full key.
  keyHash     String       @unique
  /// DEMO ONLY: full key for the local prototype portal. Never set by
  /// production issuance — purchased licenses store the hash and nothing else.
  demoPlainKey String?
  /// Commerce-side order id (arciin-web). The idempotency anchor: a retried
  /// checkout, webhook, or network failure resolves to the same license
  /// instead of minting a second one.
  externalOrderId String?  @unique
  /// free | pro | team | business
  plan        String
  /// active | inactive | expired | revoked
  status      String       @default("active")
  serverLimit Int          @default(1)
  expiresAt   DateTime?
  graceDays   Int          @default(7)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  activations Activation[]

  @@index([status])
  @@index([plan])
  @@index([customerId])
}

model Activation {
  id              String    @id @default(cuid())
  licenseId       String
  license         License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  instanceId      String
  instanceName    String?
  instanceVersion String?
  hostname        String?
  lastCheckInAt   DateTime?
  activatedAt     DateTime  @default(now())
  deactivatedAt   DateTime?

  @@unique([licenseId, instanceId])
  @@index([instanceId])
  @@index([licenseId])
}
