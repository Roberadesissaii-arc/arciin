# Hosted license server prototype (future license.arciin.com)
NODE_ENV=development
LICENSE_SERVER_PORT=4100

# SQLite file (default) or PostgreSQL URL
# LICENSE_DATABASE_URL=file:./data/licenses.db
# LICENSE_DATABASE_URL=postgresql://arciin:arciin@localhost:5432/arciin_licenses

# HMAC secret — MUST match ARCIIN_LICENSE_VERIFY_SECRET on self-hosted API
LICENSE_SIGNING_SECRET=arciin-dev-license-signing-secret-change-me

# Optional: protect POST /licenses/demo and /licenses/revoke
# LICENSE_DEMO_SECRET=
