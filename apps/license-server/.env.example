# Hosted license server (license.arciin.com)
NODE_ENV=development
LICENSE_SERVER_PORT=4100

# SQLite file (default) or PostgreSQL URL
# LICENSE_DATABASE_URL=file:./data/licenses.db
# LICENSE_DATABASE_URL=postgresql://arciin:arciin@localhost:5432/arciin_licenses

# Ed25519 signing key. VENDOR ONLY — never commit, never ship, never log.
# Generate with: node scripts/generate-license-signing-key.mjs
# The matching PUBLIC key is published in packages/config/src/license-signing.ts.
# Omitted in development: an ephemeral key is generated per process.
# LICENSE_SIGNING_KEY=
# LICENSE_SIGNING_KID=arciin-lic-2026-01

# Credentials for vendor backends (arciin-web) calling privileged routes:
# issue / revoke / lookup / deactivate-server. Comma-separated so a rotation is
# add-new, deploy, remove-old. REQUIRED in production — the server refuses to
# boot without one rather than serving license minting unauthenticated.
# LICENSE_SERVICE_TOKENS=

# Separate credential for destructive maintenance (hard delete). A compromised
# website must not be able to erase licensing records.
# LICENSE_ADMIN_TOKENS=

# LEGACY: pre-Ed25519 shared HMAC secret. Set only while instances activated
# before the migration still hold v2 tokens; they upgrade on next refresh.
# LICENSE_LEGACY_HMAC_SECRET=

# Per-IP requests per minute on instance-facing routes.
# LICENSE_RATE_LIMIT_PER_MINUTE=60
