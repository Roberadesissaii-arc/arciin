{
  "name": "arciin",
  "version": "1.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env ARCIIN_ENV_NAMESPACE=dev concurrently -n web,api,worker -c cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:all": "cross-env ARCIIN_ENV_NAMESPACE=dev concurrently -n web,api,worker,lic,acct -c cyan,magenta,yellow,green,blue \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm license-server\" \"pnpm account\"",
    "dev:web": "cross-env ARCIIN_ENV_NAMESPACE=dev PORT=3100 NEXT_DIST_DIR=.next-dev pnpm --filter @arciin/web dev",
    "dev:api": "cross-env ARCIIN_ENV_NAMESPACE=dev tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "dev:worker": "cross-env ARCIIN_ENV_NAMESPACE=dev tsx watch --tsconfig apps/worker/tsconfig.json apps/worker/src/index.ts",
    "account": "pnpm --filter @arciin/account dev",
    "account:start": "pnpm --filter @arciin/account start",
    "license-server": "pnpm --filter @arciin/license-server start",
    "license-server:dev": "pnpm --filter @arciin/license-server dev",
    "license-server:db": "pnpm --filter @arciin/license-server db:push",
    "build": "pnpm build:web && pnpm build:backend",
    "build:clean": "rm -rf apps/web/.next-build && cross-env ARCIIN_ENV_NAMESPACE=production NEXT_DIST_DIR=.next-build pnpm build:web && node scripts/verify-web-assets.mjs --dist apps/web/.next-build",
    "build:web": "pnpm --filter @arciin/web build",
    "build:api": "pnpm build:backend && test -s apps/api/dist/index.js",
    "build:worker": "pnpm build:backend && test -s apps/worker/dist/index.js",
    "verify:web-assets": "node scripts/verify-web-assets.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "deploy": "pnpm build:api && pnpm build:worker && pm2 restart arciin-api arciin-worker && pnpm deploy:web",
    "deploy:web": "bash scripts/deploy-web.sh",
    "start": "pnpm --filter @arciin/web start",
    "start:web": "pnpm --filter @arciin/web start",
    "start:api": "cross-env ARCIIN_ENV_NAMESPACE=production node apps/api/dist/index.js",
    "start:worker": "cross-env ARCIIN_ENV_NAMESPACE=production node apps/worker/dist/index.js",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:license": "vitest run --config vitest.license.config.ts",
    "test:book": "cd apps/web && tsx lib/chat/book/book.test.ts && tsx lib/chat/book/book-document.test.ts && tsx lib/chat/book/book-watchdog.test.ts && tsx lib/tasks/ai-tasks.test.ts && tsx lib/auth/idle-policy.test.ts",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "pnpm db:generate && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json && tsc --noEmit -p packages/types/tsconfig.json && tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/storage/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json && tsc --noEmit -p packages/media-ai/tsconfig.json",
    "db:generate": "prisma generate && pnpm --filter @arciin/license-server db:generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:init": "bash scripts/arciin-init.sh",
    "reset": "bash scripts/reset-instance.sh",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "icons:generate": "node scripts/generate-pwa-icons.mjs ./apps/web/public && node scripts/generate-pwa-icons.mjs ../arciin-app/public",
    "install:verify": "bash scripts/verify-install-parity.sh",
    "pdfjs:copy-wasm": "node scripts/copy-pdfjs-wasm.mjs",
    "postinstall": "prisma generate && pnpm pdfjs:copy-wasm",
    "build:docker:web": "bash scripts/docker-build-images.sh web",
    "build:docker:api": "bash scripts/docker-build-images.sh api",
    "build:docker:worker": "bash scripts/docker-build-images.sh worker",
    "docker:build": "bash scripts/docker-build-images.sh",
    "docker:up": "docker compose -f docker-compose.production.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker-compose.production.yml --env-file .env down",
    "docker:logs": "docker compose -f docker-compose.production.yml --env-file .env logs -f",
    "docker:package": "bash scripts/package-private-release.sh",
    "docker:install-private": "bash scripts/install-private.sh",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:license && pnpm test:integration",
    "test:db:setup": "bash scripts/setup-test-db.sh",
    "dev:doctor": "tsx scripts/dev-doctor.ts",
    "dev:db:setup": "bash scripts/setup-dev-db.sh",
    "deploy:lock:status": "node scripts/deploy-lock.mjs status",
    "deploy:lock:release": "node scripts/deploy-lock.mjs release",
    "deploy:safe": "node scripts/deploy-lock.mjs acquire && (pnpm build:api && pnpm build:worker && pm2 restart arciin-api arciin-worker && pnpm deploy:web; ec=$?; node scripts/deploy-lock.mjs release; exit $ec)",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report reports/playwright"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@arciin/config": "workspace:*",
    "@arciin/database": "workspace:*",
    "@arciin/shared": "workspace:*",
    "@arciin/storage": "workspace:*",
    "@arciin/types": "workspace:*",
    "@arciin/ui": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@google/genai": "^2.18.0",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fastify": "^5.12.1",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "ioredis": "^5.10.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.16",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sharp": "^0.35.3",
    "shiki": "^4.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "nanoid@^3": "^3.3.18",
      "socket.io-parser": "^4.2.7",
      "deepmerge-ts": "^8.0.0",
      "find-my-way": "^9.9.0",
      "sharp": "^0.35.3",
      "ws": "^8.21.0",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "ip-address": "^10.3.1",
      "qs": "^6.15.2",
      "body-parser": "^2.3.0",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.2",
      "@fastify/ajv-compiler>fast-uri": "^3.1.6",
      "fast-json-stringify@^6>fast-uri": "^3.1.6",
      "lucide-react": "1.14.0"
    },
    "onlyBuiltDependencies": []
  }
}
