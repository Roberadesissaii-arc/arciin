{
  "name": "arciin",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:all": "concurrently -n web,api,worker,lic,acct -c cyan,magenta,yellow,green,blue \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm license-server\" \"pnpm account\"",
    "dev:web": "pnpm --filter @arciin/web dev",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "dev:worker": "tsx watch --tsconfig apps/worker/tsconfig.json apps/worker/src/index.ts",
    "account": "pnpm --filter @arciin/account dev",
    "account:start": "pnpm --filter @arciin/account start",
    "license-server": "pnpm --filter @arciin/license-server start",
    "license-server:dev": "pnpm --filter @arciin/license-server dev",
    "license-server:db": "pnpm --filter @arciin/license-server db:push",
    "build": "pnpm build:web && pnpm build:api && pnpm build:worker",
    "build:clean": "rm -rf apps/web/.next && pnpm build:web",
    "build:web": "pnpm --filter @arciin/web build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "deploy": "pnpm build:clean && pnpm build:api && pnpm build:worker && pm2 restart arciin-web arciin-api arciin-worker",
    "deploy:web": "pnpm build:web && pm2 restart arciin-web",
    "start": "pnpm --filter @arciin/web start",
    "start:web": "pnpm --filter @arciin/web start",
    "start:api": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "start:worker": "tsx --tsconfig apps/worker/tsconfig.json apps/worker/src/index.ts",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "pnpm db:generate && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json && tsc --noEmit -p packages/types/tsconfig.json && tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/storage/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:init": "bash scripts/arciin-init.sh",
    "reset": "bash scripts/reset-instance.sh",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "icons:generate": "node scripts/generate-pwa-icons.mjs ./apps/web/public && node scripts/generate-pwa-icons.mjs ../arciin-app/public",
    "install:verify": "bash scripts/verify-install-parity.sh",
    "pdfjs:copy-wasm": "mkdir -p apps/web/public/pdfjs-wasm && cp -r node_modules/pdfjs-dist/wasm/. apps/web/public/pdfjs-wasm/",
    "postinstall": "pnpm pdfjs:copy-wasm",
    "build:docker:web": "bash scripts/docker-build-images.sh web",
    "build:docker:api": "bash scripts/docker-build-images.sh api",
    "build:docker:worker": "bash scripts/docker-build-images.sh worker",
    "docker:build": "bash scripts/docker-build-images.sh",
    "docker:up": "docker compose -f docker-compose.production.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker-compose.production.yml --env-file .env down",
    "docker:logs": "docker compose -f docker-compose.production.yml --env-file .env logs -f",
    "docker:package": "bash scripts/package-private-release.sh",
    "docker:install-private": "bash scripts/install-private.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@arciin/config": "workspace:*",
    "@arciin/database": "workspace:*",
    "@arciin/shared": "workspace:*",
    "@arciin/storage": "workspace:*",
    "@arciin/types": "workspace:*",
    "@arciin/ui": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@google/genai": "^2.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "pdfjs-dist": "^5.7.284",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sharp": "^0.34.5",
    "shiki": "^4.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
