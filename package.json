{
  "name": "arciin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "dev:worker": "tsx watch --tsconfig apps/worker/tsconfig.json apps/worker/src/index.ts",
    "build": "pnpm build:web && pnpm build:api && pnpm build:worker",
    "build:web": "next build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "start": "next start -H 0.0.0.0",
    "start:web": "next start -H 0.0.0.0",
    "start:api": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "start:worker": "tsx --tsconfig apps/worker/tsconfig.json apps/worker/src/index.ts",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:init": "bash scripts/arciin-init.sh",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@arciin/database": "workspace:*",
    "@arciin/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
