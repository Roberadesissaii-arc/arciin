# Arciin API + worker image.
#
# Multi-stage so the development toolchain does not ship. The previous image was
# a single stage running `pnpm install` with no `--prod` and then `COPY . .`, so
# eslint, typescript, vitest, tailwind, the Playwright client and the whole test
# and docs tree all landed in production.
#
# What *does* have to ship is less obvious than usual: this deployment runs the
# API from TypeScript source through `tsx` rather than from compiled output, and
# the entrypoint applies migrations with the Prisma CLI before starting. Both are
# therefore runtime dependencies (they are declared as such in package.json), and
# apps/*/src is runtime code, not build input. Pruning either would produce a
# smaller image that cannot boot.

# ---------- deps: full install, used only to build ----------
# Node 24, matching the runtime this release was certified on.
#
# The images pinned node:20-alpine while every other gate ran on Node 24, and
# the dependency tree had moved past it: undici 8 calls
# webidl.util.markAsUncloneable, which does not exist before Node 22, so the
# API container built cleanly, applied its migrations, and then died on its
# first import. package.json now declares engines.node >= 22 so the two cannot
# drift apart again.
# Debian slim, not Alpine.
#
# pdfjs-dist pulls @napi-rs/canvas, and its musl build dies with SIGILL —
# "Illegal instruction (core dumped)" — the moment pdfjs is imported. That is a
# native crash no try/catch can see, so it took the worker process down with it:
# a PDF upload left its metadata job stalled, the asset stuck on PROCESSING, and
# the container restarting. The glibc build is what the host this release was
# verified on actually runs, so the image now matches it.
FROM node:24-slim AS deps
WORKDIR /app
# Bake the pinned pnpm into the image.
#
# `corepack enable` alone only installs the shim: the first pnpm invocation
# downloads the version pinned in package.json. That turned every container
# start into a call to the npm registry, which a production host is entitled to
# block — and on this one it printed "Corepack is about to download pnpm" and
# the worker restarted twice, abandoning a job mid-flight. Preparing it at build
# time means the running container never reaches for the network to start.
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/media-ai/package.json packages/media-ai/package.json

# postinstall (pdfjs wasm copy) needs scripts/ on disk, which is not in this
# layer yet — it is re-run explicitly in the builder stage below.
RUN pnpm install --frozen-lockfile --ignore-scripts

# ---------- builder: generate the Prisma client ----------
FROM deps AS builder
WORKDIR /app
COPY . .
# pnpm nests the generated client under .pnpm/; materialize the classic
# node_modules/.prisma path so the runtime stage can COPY it by a stable name.
RUN pnpm db:generate \
  && PRISMA_SRC="$(find node_modules -type d -path '*/node_modules/.prisma' | head -n 1)" \
  && test -n "$PRISMA_SRC" \
  && mkdir -p node_modules/.prisma \
  && cp -a "$PRISMA_SRC"/. node_modules/.prisma/

# ---------- runtime: production dependencies only ----------
FROM node:24-slim AS runtime
WORKDIR /app

# bash/psql/curl for the entrypoint + health checks; ffmpeg and poppler-utils
# (pdftoppm) power on-demand video/PDF thumbnail generation.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash postgresql-client curl ca-certificates ffmpeg poppler-utils util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/install-cloudflared.sh /tmp/install-cloudflared.sh
RUN chmod +x /tmp/install-cloudflared.sh && /tmp/install-cloudflared.sh && rm /tmp/install-cloudflared.sh

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/media-ai/package.json packages/media-ai/package.json

# --prod drops eslint, typescript, vitest, tailwind, @types/* and the Playwright
# client. tsx and prisma stay because they are declared as dependencies.
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# Runtime source. .dockerignore keeps tests, docs, reports and caches out.
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY packages ./packages
COPY prisma ./prisma
COPY scripts ./scripts
COPY tsconfig.base.json tsconfig.json ./

# The generated client, rather than re-running the generator with no CLI here.
# Generate the Prisma client here rather than copying it from the builder.
# pnpm keeps the generated client inside its virtual store
# (node_modules/.pnpm/@prisma+client@…/node_modules/.prisma), so there is no
# node_modules/.prisma to copy — the COPY that tried failed the build outright.
# The CLI and the schema are both present in this stage, so generating is both
# simpler and correct wherever pnpm decides to put it.
RUN pnpm db:generate

ENV NODE_ENV=production
ENV API_PORT=4000
EXPOSE 4000

RUN chmod +x scripts/arciin-init.sh scripts/entrypoint-api.sh

# Run as a non-root user (uid/gid 1000 by default). Pin a matching host uid via
# `user:` in compose so the bind-mounted data dir stays writable.
# node:*-slim already ships a "node" user at uid 1000 — reuse it rather than
# failing on a duplicate id.
RUN set -eu; \
    getent group 1000 >/dev/null 2>&1 || groupadd -g 1000 arciin; \
    getent passwd 1000 >/dev/null 2>&1 || useradd -u 1000 -g 1000 -M -s /usr/sbin/nologin arciin; \
    chown -R 1000:1000 /app
USER 1000:1000

# bash, not sh. The entrypoint sets `-o pipefail`, which Alpine's busybox ash
# accepts and Debian's dash does not — with `sh` the container died on line 2
# of its own entrypoint, restarting forever.
CMD ["bash", "scripts/entrypoint-api.sh"]
