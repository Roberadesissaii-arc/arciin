# Arciin — production / private distribution environment
# Copy to .env on the customer host (install script does this).
# Do not commit real secrets.

NODE_ENV=production

# ── Image tags (optional; defaults match docker-compose.production.yml) ─────
# Later: point at a private registry, e.g. ghcr.io/your-org/arciin-web:1.0.0
ARCIIN_IMAGE_WEB=arciin/arciin-web:latest
ARCIIN_IMAGE_API=arciin/arciin-api:latest
ARCIIN_IMAGE_WORKER=arciin/arciin-worker:latest

# ── Host HTTP port (Caddy) ──────────────────────────────────────────────────
ARCIIN_HTTP_PORT=80

# ── Host storage (bind mount) ───────────────────────────────────────────────
# Path on the customer machine. Files live here, not inside containers.
# Examples:
#   /srv/arciin-storage/arciin
#   /mnt/nvme/arciin-data
ARCIIN_HOST_DATA_DIR=/srv/arciin-storage/arciin

# Inside api/worker containers (must match compose volume target)
ARCIIN_DATA_DIR=/data/arciin

# ── Secrets (required — install script generates if missing) ────────────────
# Never ship real values in packages or docs.
ARCIIN_SETUP_TOKEN=
SESSION_SECRET=
# Encrypts vault / webhook / integration secrets at rest (64 hex chars).
# openssl rand -hex 32
ARCIIN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Compose-injected DB/Redis URLs ──────────────────────────────────────────
# docker-compose.production.yml builds these from POSTGRES_PASSWORD / REDIS_PASSWORD.
# Listed for documentation; do not point at host localhost when using Compose.
# DATABASE_URL=postgresql://arciin:<password>@postgres:5432/arciin
# REDIS_URL=redis://:<password>@redis:6379

# ── Container user (bind-mount ownership) ───────────────────────────────────
# Match the host user that owns ARCIIN_HOST_DATA_DIR.
ARCIIN_PUID=1000
ARCIIN_PGID=1000
ARCIIN_WORKER_CONCURRENCY=2

# ── URLs ────────────────────────────────────────────────────────────────────
# Browser-facing URL (LAN IP or domain). Use http://localhost for local-only.
ARCIIN_PUBLIC_URL=http://localhost
# Internal service URL (compose network)
ARCIIN_API_URL=http://api:4000

# Browser API path (same-origin via Caddy)
NEXT_PUBLIC_API_BASE_URL=/api
# Leave empty so the browser uses window.location.origin for Socket.IO
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_ARCIIN_API_ORIGIN=
NEXT_PUBLIC_ARCIIN_PUBLIC_URL=

# Cloudflare tunnel target inside the stack (api → Caddy)
ARCIIN_TUNNEL_TARGET=http://caddy:80

SESSION_COOKIE_NAME=arciin_session

MAX_UPLOAD_SIZE_MB=20480
UPLOAD_RATE_LIMIT_PER_MINUTE=500
LOG_MAX_FILE_BYTES=1800000

# ── License / demo (no Stripe, no license cloud yet) ────────────────────────
# Activation is in-app: Settings → License with demo keys from the marketing
# demo portal or built-in keys:
#   ARCIIN-DEV-PRO | ARCIIN-DEV-TEAM | ARCIIN-DEV-BUSINESS | ARCIIN-DEV-FREE
#   arc_demo_pro_… | arc_demo_team_… | arc_demo_business_…
# No license server env vars required for the prototype.
