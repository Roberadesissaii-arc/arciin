+      ? getFileExtension(input.originalFilename)
+      : ""
+    const extension = preservableAudioExtensions.has(nameExtension)
+      ? nameExtension
+      : preservableAudioExtensions.has(input.extension)
+        ? input.extension
+        : "m4a"
+
+    return {
+      mediaType: "AUDIO",
+      mimeType: audioMimeByExtension[extension] ?? "audio/mp4",
+      extension,
+    }
